# Production reverse proxy + auto HTTPS (Let's Encrypt)
# Both DuckDNS domains must point to the EC2 Elastic IP.

# Backend: Django API + WebSocket (Daphne ASGI)
rag-support-api.duckdns.org {
	encode gzip

	# Media uploads (knowledge PDFs, etc.)
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Django admin / DRF static files (collectstatic)
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}

# Frontend: separate container (frontend repo's docker-compose.prod.yml) on the shared "supportai" network
rag-support-assistant.duckdns.org {
	encode gzip
	reverse_proxy supportai_frontend:80
}
