# Copy to .env on the EC2 server (never commit real .env)
#   cp env.prod.sample .env
# Do not wrap values in quotes.

# Django
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_50_CHARS_MINIMUM
DEBUG=False
ALLOWED_HOSTS=rag-support-api.duckdns.org

# Database (AWS RDS PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_HOST=supportai-db.xxxxxxxxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=supportai
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_RDS_MASTER_PASSWORD
DB_SSLMODE=require

# Redis (Docker internal)
REDIS_URL=redis://redis:6379/0
SEED_DEMO_DATA=false

# Frontend (served by Caddy on the same EC2)
CORS_ALLOWED_ORIGINS=https://rag-support-assistant.duckdns.org
CSRF_TRUSTED_ORIGINS=https://rag-support-api.duckdns.org,https://rag-support-assistant.duckdns.org
FRONTEND_URL=https://rag-support-assistant.duckdns.org

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

MEDIA_ROOT=media_uploads
MEDIA_URL=/media/

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Vector RAG
RAG_TOP_K=4
RAG_MIN_SCORE=0.32
RAG_EMBED_DIM=384

# Google OAuth (same Web Client ID as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Email (optional — Gmail App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
